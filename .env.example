# --- BACKEND / SERVIDOR API ---
PORT=4000
NODE_ENV=production

# Clave secreta para firma de Tokens JWT y autenticación
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_snowpoint_2026

# Base de datos:
# 1. Modo Local (SQLite predeterminado):
DATABASE_URL="file:./dev.db"

# 2. Modo Cloud / Vercel (Supabase PostgreSQL / Neon):
# DATABASE_URL="postgresql://postgres:[TU_CONTRASEÑA_SUPABASE]@db.[TU_PROYECTO].supabase.co:5432/postgres?sslmode=require"
# DIRECT_URL="postgresql://postgres:[TU_CONTRASEÑA_SUPABASE]@db.[TU_PROYECTO].supabase.co:5432/postgres?sslmode=require"

# --- FRONTEND (REACT / VITE) ---
# URL base de la API backend (dejar en /api si se usa proxy/monorepo o la URL de Vercel)
VITE_API_URL="/api"
